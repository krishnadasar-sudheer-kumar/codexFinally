# FinAlly runtime configuration
APP_PORT=8000

# Database path inside the container. The /app/db directory is volume-mounted.
DB_PATH=/app/db/finally.db

# Market data uses the built-in simulator unless MASSIVE_API_KEY is set.
MASSIVE_API_KEY=

# LLM configuration. Set LLM_MOCK=true for deterministic local/E2E runs.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
LLM_MOCK=false
